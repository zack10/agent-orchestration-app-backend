NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:15432/agent_orchestration
RABBITMQ_URL=amqp://guest:guest@localhost:15673

# Required in production. Send as: Authorization: Bearer <token>
API_AUTH_TOKEN=replace-with-a-long-random-token
API_AUTH_ACTOR=api-token:default
# Local development only: skip auth when no token is set. Refused in production.
AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:3000

# 32 random bytes encoded as 64 hexadecimal characters.
ENCRYPTION_KEY=replace-with-64-hex-characters

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# Extra OpenAI-compatible providers as a JSON array (README: "Adding an LLM provider"), e.g.
# LLM_PROVIDERS=[{"key":"groq","baseUrl":"https://api.groq.com/openai/v1","apiKeyEnv":"GROQ_API_KEY","supportsTools":true}]
LLM_PROVIDERS=
# Used by agents that have no provider/model set.
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-flash-latest

TASK_MAX_ATTEMPTS=3
TASK_RETRY_DELAY_MS=5000
TASK_LEASE_MS=300000
EXECUTION_LEASE_MS=300000
# How the run graph makes a change: single_shot (one LLM call per attempt) or
# tool_loop (the agent uses sandbox tools until it finishes or a budget runs out).
EXECUTION_AGENT_MODE=single_shot
# Model calls per attempt in tool_loop mode.
AGENT_MAX_STEPS=30
# Execution consumers: deliveries before dead-lettering, and delay between them.
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_DELAY_MS=30000
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=16000
# Retries for rate-limited/overloaded LLM calls (429/503/529); waits up to 60s each
LLM_RATE_LIMIT_RETRIES=3
API_RATE_LIMIT_PER_MINUTE=120

# HTTP connectors are denied unless the target hostname is listed.
MCP_HTTP_ALLOWED_HOSTS=api.example.com
MCP_HTTP_ALLOW_PRIVATE_IPS=false
MCP_HTTP_TIMEOUT_MS=10000
MCP_HTTP_MAX_RESPONSE_BYTES=1000000

GENERATED_CODE_MAX_FILES=25
GENERATED_CODE_MAX_FILE_BYTES=500000
STORE_RAW_LLM_OUTPUT=false

# Vertical-slice execution
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# How often enabled issue-tracker integrations are polled (TRELLO_POLL_INTERVAL_MS also accepted).
INTEGRATION_POLL_INTERVAL_MS=30000
WORKSPACE_ROOT=workspaces
# Keep each execution's clone after the run step (for debugging); deleted by default.
KEEP_WORKSPACES=false
ARTIFACT_ROOT=artifacts
