NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:15432/agent_orchestration
RABBITMQ_URL=amqp://guest:guest@localhost:15673

# Required in production. Send as: Authorization: Bearer <token>
API_AUTH_TOKEN=replace-with-a-long-random-token
API_AUTH_ACTOR=api-token:default
# Local development only: skip auth when no token is set. Refused in production.
AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:3000

# 32 random bytes encoded as 64 hexadecimal characters.
ENCRYPTION_KEY=replace-with-64-hex-characters

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

TASK_MAX_ATTEMPTS=3
TASK_RETRY_DELAY_MS=5000
TASK_LEASE_MS=300000
EXECUTION_LEASE_MS=300000
# Execution consumers: deliveries before dead-lettering, and delay between them.
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_DELAY_MS=30000
LLM_REQUEST_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=16000
API_RATE_LIMIT_PER_MINUTE=120

# HTTP connectors are denied unless the target hostname is listed.
MCP_HTTP_ALLOWED_HOSTS=api.example.com
MCP_HTTP_ALLOW_PRIVATE_IPS=false
MCP_HTTP_TIMEOUT_MS=10000
MCP_HTTP_MAX_RESPONSE_BYTES=1000000

GENERATED_CODE_MAX_FILES=25
GENERATED_CODE_MAX_FILE_BYTES=500000
STORE_RAW_LLM_OUTPUT=false

# Vertical-slice execution
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
TRELLO_POLL_INTERVAL_MS=30000
WORKSPACE_ROOT=workspaces
ARTIFACT_ROOT=artifacts
