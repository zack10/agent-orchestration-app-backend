generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum ExternalSystem {
  TRELLO
  JIRA
}

enum AgentRole {
  frontend
  backend
  qa
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  READY_FOR_TEST
  DONE
  BLOCKED
}

enum ContractStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

model Agent {
  id          String        @id @default(uuid())
  name        String
  description String?
  config      Json?
  provider    String?       @default("gemini")
  model       String?       @default("gemini-flash-latest")
  skills      Skill[]       @relation("AgentSkills")
  tasks       Task[]
  resources   MCPResource[] @relation("AgentResources")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  proposedContracts ApiContract[] @relation("ProposedContracts")

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  baseInstructions String?
}

model Project {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  techStack            String?
  architectureDecisions String?
  contextData          Json?    @default("{}")

  agents               Agent[]
  tasks                Task[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String?
  logic       String
  agents      Agent[]  @relation("AgentSkills")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id        String   @id @default(uuid())
  payload   Json
  status    String
  agent     Agent    @relation(fields: [agentId], references: [id])
  agentId   String
  result    Json?

  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  content    Json
  sender     Agent    @relation("SentMessages", fields: [senderId], references: [id])
  senderId   String
  receiver   Agent    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String
  createdAt  DateTime @default(now())
}

model MCPResource {
  id        String   @id @default(uuid())
  type      String
  name      String
  config    Json
  agents    Agent[]  @relation("AgentResources")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkItem {
  id             String         @id @default(uuid())
  externalSystem ExternalSystem
  externalId     String
  boardId        String

  status       WorkItemStatus @default(TODO)
  assigneeRole AgentRole?

  title       String
  description String?
  labels      Json?

  lockOwner    String?
  lockUntil    DateTime?
  attemptCount Int       @default(0)
  lastError    String?
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalSystem, externalId])
  @@index([externalSystem, boardId])
  @@index([status, assigneeRole])
}

model ApiContract {
  id      String         @id @default(uuid())
  name    String
  version Int
  schema  Json
  status  ContractStatus @default(PROPOSED)

  proposedBy   Agent?  @relation("ProposedContracts", fields: [proposedById], references: [id])
  proposedById String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
  @@index([name, status])
}
