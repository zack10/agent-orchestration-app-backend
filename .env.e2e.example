# End-to-end test settings. Copy to .env.e2e (gitignored) and fill in.
# The server must already be running (npm run dev:local); these variables are
# read by the test runner only. Suites whose variables are missing are skipped.

# --- Target server (smoke suite needs only this) ---
E2E_BASE_URL=http://localhost:3001
# Set if the server uses API_AUTH_TOKEN; leave empty when AUTH_DISABLED=true
E2E_API_TOKEN=

# --- LLM (task + execution suites) ---
# gemini | openai | anthropic
E2E_LLM_PROVIDER=
E2E_LLM_MODEL=
E2E_LLM_API_KEY=
# Optional reasoning effort per call kind, e.g. {"triage":"low","plan":"low","analyze":"low"}
E2E_REASONING_EFFORT=

# --- Trello (execution suite) ---
E2E_TRELLO_API_KEY=
E2E_TRELLO_TOKEN=
E2E_TRELLO_BOARD_ID=
# List the test card is created in
E2E_TRELLO_LIST_ID=
# Must already exist on the board
E2E_TRELLO_LABEL=agent

# --- GitHub (execution suite) ---
# Use a THROWAWAY repo: a run pushes agent/<executionId> and opens a draft PR.
# The server itself needs GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY in its env.
E2E_GITHUB_OWNER=
E2E_GITHUB_REPO=
E2E_GITHUB_DEFAULT_BRANCH=main
E2E_GITHUB_INSTALLATION_ID=
# Optional: that repo's environment as JSON (a verificationConfig), e.g.
# {"toolchain":{"image":"python:3.12","setup":["pip","install","-r","requirements.txt"],"checks":{"test":["python","-m","pytest"]}}}
# Default: the Node benchmark project (npm in node:20-bookworm).
E2E_ENVIRONMENT=
# Fine-grained PAT for the sandbox repo only. The execution suite uses it
# (optional; Pull requests + Contents read/write) to check the PR is a draft
# and to close it / delete the branch. The coding benchmark REQUIRES it
# (Contents read/write) to point main at each scenario's code.
E2E_GITHUB_TOKEN=

# --- Behaviour ---
# false = stop after the diff and reject publishing (no PR is opened)
E2E_PUBLISH=true
# true = leave the Trello card, PR and branch in place for inspection
E2E_KEEP_RESOURCES=false
# Optional ticket override (defaults append a marker line to README.md)
E2E_TICKET_TITLE=
E2E_TICKET_DESCRIPTION=

# --- Coding benchmark (npm run eval:coding) ---
# Runs per scenario (override with --runs). Each run makes about 3-8 LLM calls.
E2E_EVAL_RUNS=1

# --- Timeouts (ms) ---
E2E_POLL_INTERVAL_MS=5000
E2E_TASK_TIMEOUT_MS=180000
E2E_PLAN_TIMEOUT_MS=120000
E2E_RUN_TIMEOUT_MS=1200000
E2E_PUBLISH_TIMEOUT_MS=300000
