{
  "name": "agent-orchestration-app-backend",
  "version": "1.0.0",
  "description": "Backend for the Agent Orchestration Application",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npm run dev:local",
    "dev:local": "dotenv -e .env.local -- ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:cloud": "dotenv -e .env.cloud -- ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:push:local": "dotenv -e .env.local -- npx prisma db push",
    "prisma:push:cloud": "dotenv -e .env.cloud -- npx prisma db push",
    "build": "rimraf dist && tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "prisma": "^5.12.1",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/uuid": "^10.0.0",
    "amqplib": "^1.0.3",
    "axios": "^1.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.19.2",
    "uuid": "^13.0.0"
  }
}
