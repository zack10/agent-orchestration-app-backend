# Template for .env.prod, read by docker-compose.prod.yml (docs/guides/PRODUCTION_RUN.md).
# Every setting in .env.example works here too; the stack itself sets NODE_ENV,
# PORT, DATABASE_URL, RABBITMQ_URL, WORKSPACE_ROOT and ARTIFACT_ROOT.

# Passwords of the stack's own database and broker. Letters and digits only
# (they go into URLs), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# Absolute path on a Linux filesystem (in WSL: under /home, never /mnt/c or /mnt/f)
# for workspaces, artifacts and generated code. Mounted at the same path in the app.
AGENT_DATA_DIR=/home/you/agent-data
# Host port of the API, bound to 127.0.0.1 only.
APP_PORT=3001

# Required in production. Send as: Authorization: Bearer <token>
API_AUTH_TOKEN=
API_AUTH_ACTOR=api-token:default
CORS_ORIGINS=http://localhost:3000
# 32 random bytes encoded as 64 hexadecimal characters (`openssl rand -hex 32`).
# Integration credentials are encrypted with it: keep it, or they can't be read.
ENCRYPTION_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-5-mini
LLM_DAILY_TOKEN_LIMIT=2000000

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
